@model List<CoinKeep.Web.Models.Wallet>

@{
    ViewData["Title"] = "資金帳戶";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>資金帳戶</h2>
        <a asp-controller="Wallet" asp-action="Create" class="btn btn-primary">新增資金帳戶</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            目前尚未建立任何資金帳戶。
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>帳戶名稱</th>
                    <th>帳戶類型</th>
                    <th>初始餘額</th>
                    <th>建立時間</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var wallet in Model)
                {
                    <tr>
                        <td>@wallet.WalletName</td>
                        <td>@wallet.WalletType</td>
                        <td>@wallet.InitialBalance.ToString("N2")</td>
                        <td>@wallet.CreatedAt.ToString("yyyy/MM/dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>