@model List<CoinKeep.Web.Models.Wallet>

@{
    ViewData["Title"] = "我的錢包";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>我的錢包</h2>
        <a asp-controller="Wallet" asp-action="Create" class="btn btn-primary">新增資產</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            目前尚未建立任何資產。
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>資產名稱</th>
                    <th>資產類型</th>
                    <th>初始金額</th>
                    <th>建立時間</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var wallet in Model)
                {
                    <tr>
                        <td>@wallet.WalletName</td>
                        <td>
                            @switch (wallet.WalletType)
                            {
                                case "Cash":
                                    <text>現金</text>
                                    break;
                                case "Bank":
                                    <text>銀行存款</text>
                                    break;
                                case "EWallet":
                                    <text>電子錢包</text>
                                    break;
                            }
                        </td>
                        <td>@wallet.InitialBalance.ToString("N2")</td>
                        <td>@wallet.CreatedAt.ToString("yyyy/MM/dd")</td>
                        <td>
                            <a asp-controller="Wallet" asp-action="Edit" asp-route-id="@wallet.WalletId" class="btn btn-sm btn-outline-primary">編輯</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>